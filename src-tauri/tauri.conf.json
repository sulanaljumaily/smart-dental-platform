{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dental Platform",
  "version": "1.0.0",
  "identifier": "com.dentalplatform.pro",
  "build": {
    "beforeBuildCommand": "pnpm run build:pro",
    "beforeDevCommand": "pnpm run dev",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "نظام إدارة العيادات - Dental Platform",
        "url": "index.html",
        "fullscreen": false,
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "devtools": true,
        "theme": "Dark",
        "backgroundColor": "#030f21"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "نظام إدارة العيادات - Dental Platform",
    "longDescription": "برنامج سطح المكتب لإدارة عيادات الأسنان، المواعيد، سجلات المرضى، الإيرادات والربط مع المعامل والموردين",
    "copyright": "Dental Platform © 2026",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
